# 浏览器端 axios 使用的 API 基础路径。
VITE_API_BASE_URL=/api

# axios 请求超时时间，单位毫秒。
VITE_API_TIMEOUT=30000

# 可选的 WebSocket 基础地址，留空时使用当前页面域名。
VITE_WS_BASE_URL=

# 可选的构建输出目录，默认输出到同级后端项目的 Spring Boot static 目录。
VITE_BUILD_OUT_DIR=

# 开发环境后端基础地址，Vite 代理和部分默认配置会优先使用它。
VITE_DEV_BACKEND_URL=http://localhost:8080

# SSH 终端在开发环境使用的 WebSocket 基础地址，留空时由 VITE_DEV_BACKEND_URL 自动转换。
VITE_DEV_SSH_WS_BASE_URL=

# 系统配置里本地存储域名的默认值，留空时使用 VITE_DEV_BACKEND_URL。
VITE_DEFAULT_STORAGE_DOMAIN=

# Vite 开发服务和代理目标。
VITE_DEV_SERVER_PORT=3000
VITE_DEV_API_TARGET=
VITE_DEV_WS_TARGET=

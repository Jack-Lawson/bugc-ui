# iOS Build Configuration
# Copy this file to .env.ios and update with your actual values

# Backend API Base URL (must be HTTPS for iOS builds)
VITE_API_BASE_URL=https://your-backend-domain.com/api

# WebSocket Base URL (must be WSS for iOS builds)
VITE_WS_BASE_URL=wss://your-backend-domain.com/ws

# Optional: Dev backend URL for local testing
VITE_DEV_BACKEND_URL=https://your-backend-domain.com

# Optional: Dev API target
VITE_DEV_API_TARGET=https://your-backend-domain.com

# Optional: Dev WebSocket target
VITE_DEV_WS_TARGET=wss://your-backend-domain.com/ws

# Optional: SSH terminal WebSocket URL
VITE_DEV_SSH_WS_BASE_URL=wss://your-backend-domain.com/ws/ssh

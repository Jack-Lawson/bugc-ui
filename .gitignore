# Dependencies
node_modules/

# Production build output
dist/
build/

# Vite / Vue / TypeScript local cache
.vite/
node_modules/.vite/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime and app logs
logs/
*.log

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
user_config.json
*.pem
*.key
*.crt

# Editor and IDE local state
.idea/
*.iml
.vscode/

# OS metadata
.DS_Store
Thumbs.db

# Local uploads and generated user files
uploads/

# Java / Maven output, kept here because this frontend builds into a Spring static directory.
target/
**/target/

# UniApp local build and private IDE settings
uniapp/unpackage/
uniapp/project.private.config.json

# Note: this Vite project writes production assets to a sibling backend static directory.
# A repository .gitignore cannot ignore files outside its own worktree; keep the backend
# repository's ignore rules aligned if that output directory is tracked separately.
